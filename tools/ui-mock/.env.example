VITE_SCANNER_API_URL=http://localhost:5177
CRYPTO_EDGE_RUNTIME_MODE=DEVELOPMENT_DEMO
# AI Research is fail-closed by default. Configure secrets only in the server environment.
CRYPTO_EDGE_AI_RESEARCH_PROVIDER=DISABLED
CRYPTO_EDGE_AI_RESEARCH_MODEL=
OPENAI_API_KEY=
CRYPTO_EDGE_AI_RESEARCH_TIMEOUT_MS=30000
CRYPTO_EDGE_AI_RESEARCH_MAX_CONCURRENCY=1
CRYPTO_EDGE_AI_RESEARCH_SESSION_SECRET=
CRYPTO_EDGE_AI_RESEARCH_SQLITE_PATH=
CRYPTO_EDGE_AI_QUEUE_SQLITE_PATH=
CRYPTO_EDGE_AI_WORKER_ENABLED=0
CRYPTO_EDGE_AI_WORKER_INTERVAL_MS=60000
CRYPTO_EDGE_AI_WORKER_MAX_CONCURRENCY=1
CRYPTO_EDGE_AI_WORKER_MAX_PER_CYCLE=5
CRYPTO_EDGE_AI_MAX_ANALYSES_PER_HOUR=10
CRYPTO_EDGE_AI_MAX_ANALYSES_PER_DAY=50
CRYPTO_EDGE_AI_MAX_TOKENS_PER_DAY=250000
# Cost limiting is enabled only when all three trusted operational values are configured.
CRYPTO_EDGE_AI_MAX_DAILY_COST_USD=
CRYPTO_EDGE_AI_INPUT_COST_PER_MILLION_USD=
CRYPTO_EDGE_AI_OUTPUT_COST_PER_MILLION_USD=
CRYPTO_EDGE_AI_WORKER_MAX_ATTEMPTS=3
CRYPTO_EDGE_AI_WORKER_RETRY_BASE_MS=30000
CRYPTO_EDGE_AI_WORKER_LEASE_MS=180000
