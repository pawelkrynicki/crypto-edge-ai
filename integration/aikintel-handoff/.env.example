# Crypto Edge side: set on the product server, never in the repository.
CRYPTO_EDGE_AUTH_MODE=AIKINTEL
CRYPTO_EDGE_AIKINTEL_SSO_SECRET=<same-secret-as-AIKINTEL-CRYPTO_EDGE_SSO_SECRET>
CRYPTO_EDGE_AIKINTEL_ACTOR_KEY=<separate-stable-actor-mapping-secret>
CRYPTO_EDGE_AIKINTEL_ISSUER=aikintel
CRYPTO_EDGE_AIKINTEL_AUDIENCE=crypto-edge
CRYPTO_EDGE_AIKINTEL_AUTH_STATE_PATH=C:\CryptoEdge\state\aikintel-auth.json
CRYPTO_EDGE_AIKINTEL_COOKIE_SECURE=1
CRYPTO_EDGE_AIKINTEL_LAUNCH_TTL_SECONDS=60

# AIKINTEL side: set on the AIKINTEL backend, never in browser code.
CRYPTO_EDGE_BASE_URL=https://cryptoedge.crmallintraders.pl
CRYPTO_EDGE_SSO_SECRET=<same-secret-as-Crypto-Edge-AIKINTEL-SSO-secret>
CRYPTO_EDGE_SSO_AUDIENCE=crypto-edge
CRYPTO_EDGE_SSO_ISSUER=aikintel
